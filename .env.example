# Copy to .env on the server and fill in. Never commit .env.

PUBLIC_URL=https://konkurs.example.ru
POSTGRES_PASSWORD=

# Random string, 32+ characters (for example: openssl rand -hex 32).
# Used to fingerprint phone numbers; changing it later breaks duplicate-vote checks.
PHONE_HASH_SECRET=

# Contest dates, Moscow time
REGISTRATION_START=2026-11-11T00:00:00+03:00
REGISTRATION_END=2026-11-25T23:59:59+03:00
# VIDEO_UPLOAD_END=           # defaults to REGISTRATION_END
VOTING_START=2026-11-26T00:00:00+03:00
VOTING_END=2026-12-05T23:59:59+03:00
RESULTS_DATE=2026-12-09T12:00:00+03:00
PRIZES_BY=2026-12-25T23:59:59+03:00

# Documents approved by the lawyer (links shown at login and registration)
RULES_URL=
PRIVACY_URL=
CONSENT_URL=
CONSENT_VERSION=

# Yandex SmartCaptcha (required in production)
CAPTCHA_PROVIDER=smartcaptcha
SMARTCAPTCHA_SITE_KEY=
SMARTCAPTCHA_SERVER_KEY=

# VK ID: app in the VK ID cabinet. Redirect URL: ${PUBLIC_URL}/auth/vk/callback
# Request access to the phone number for the app.
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_SCOPE=phone
# Defaults — verify against the VK ID docs:
# VK_AUTHORIZE_URL=https://id.vk.com/authorize
# VK_TOKEN_URL=https://id.vk.com/oauth2/auth
# VK_USERINFO_URL=https://id.vk.com/oauth2/user_info

# Sber ID: organisation on the Sber ID portal. Redirect URL: ${PUBLIC_URL}/auth/sber/callback
SBER_CLIENT_ID=
SBER_CLIENT_SECRET=
SBER_SCOPE=openid mobile
SBER_CERT_P12_PATH=/secrets/sber-client.p12
SBER_CERT_PASSWORD=
# SBER_CA_PATH=/secrets/russian_trusted_root_ca.pem
# Defaults — verify against the Sber ID docs:
# SBER_AUTHORIZE_URL=https://id.sber.ru/CSAFront/oidc/authorize.do
# SBER_TOKEN_URL=https://oauth.sber.ru/ru/prod/tokens/v2/oidc
# SBER_USERINFO_URL=https://oauth.sber.ru/ru/prod/sberbankid/v2.1/userinfo

# Video limits
VIDEO_MAX_SECONDS=60
VIDEO_TOLERANCE_SECONDS=0.5
VIDEO_MAX_MB=200
